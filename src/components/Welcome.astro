---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { Image } from 'astro:assets';
import dianaFoto from '../assets/Diana-No-Background.png';
---

<Layout title="Diana Borro | Fullstack Developer">
	<main class="relative min-h-screen bg-[#22252a] text-white flex flex-col justify-between p-8 md:p-16 overflow-hidden select-none">

		<div class="self-end max-w-xl text-right z-10 opacity-0 animate-reveal-text delay-100">
			<p class="text-[10px] md:text-xs tracking-widest text-zinc-400 font-mono uppercase leading-relaxed">
				Here to make your website great. I use avantguard technologies to grant speed, organic traffic (SEO), and a premium customer experience.
			</p>
		</div>

		<div class="absolute inset-0 flex items-end justify-center pointer-events-none z-0 opacity-0 animate-reveal-image delay-400">
			<Image
				src={dianaFoto}
				alt="Diana Borro portrait"
				class="w-full max-w-3xl h-auto object-contain translate-y-4"
				loading="eager"
			/>
		</div>

		<div class="flex flex-col md:flex-row justify-between items-start md:items-end w-full mt-auto pt-24 z-10 opacity-0 animate-reveal-text delay-250">

			<div class="flex flex-col tracking-tight font-sans">
				<h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-2 leading-none">
					Diana Borro
				</h1>
				<p class="text-4xl md:text-6xl lg:text-7xl font-light text-zinc-300 leading-none">
					Fullstack Developer
				</p>
			</div>

			<div class="mt-8 md:mt-0 self-end md:self-auto">
				<a href="#about" aria-label="Scroll down" class="block p-2 text-white hover:text-zinc-400 transition-colors duration-200">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-12 h-12 md:w-16 md:h-16 animate-bounce">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
					</svg>
				</a>
			</div>

		</div>

	</main>
</Layout>
